{
  "name": "melee-web-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser shell for melee-web: boot, settings, lobby, touch overlay, PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "relay": "node tests/e2e/relay-server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
