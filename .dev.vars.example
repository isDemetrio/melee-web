# Cloudflare Realtime TURN key identifier.
TURN_KEY_ID=
# Secret API token used only for the upstream TURN Authorization header.
TURN_KEY_API_TOKEN=
# Credential lifetime in seconds; defaults to 3600, maximum 86400.
TURN_TTL_SECONDS=
# Access application audience tag.
ACCESS_AUD=
# Team hostname only, for example your-team.cloudflareaccess.com (no scheme or path).
ACCESS_TEAM_DOMAIN=
# Set to 1 only for development; refused on main or when branch metadata is absent.
ACCESS_DEV_BYPASS=
# Pages branch metadata; use a non-main value explicitly for local development.
CF_PAGES_BRANCH=
# Pages commit metadata used by the health endpoint.
CF_PAGES_COMMIT_SHA=
# ASSETS_R2 is an R2 binding configured in wrangler.toml, not a string environment variable.
