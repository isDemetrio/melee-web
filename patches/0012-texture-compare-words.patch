+// Whether `size` bytes at `a` and `b` are equal: the same answer as !memcmp(a, b, size). Not memcmp:
+// Emscripten's musl compares one byte at a time (~1.9 ns/byte, docs/RENDERER_JS_COST.md), and this
+// compare runs over every byte of a texture whose RAM-version shortcut missed. Eight bytes per load,
+// unaligned through memcpy, four loads per step; the last eight bytes are compared as one word that
+// overlaps the words before it, so no tail byte is left out and none is read past `size`.
+inline bool same_bytes(const uint8_t* a, const uint8_t* b, size_t size) {
+  if (size < 8) {
+    for (size_t i = 0; i < size; ++i)
+      if (a[i] != b[i]) return false;
+    return true;
+  }
+  const auto word = [](const uint8_t* p) { uint64_t v; std::memcpy(&v, p, 8); return v; };
+  size_t i = 0;
+  for (; i + 32 <= size; i += 32)
+    if ((word(a + i) ^ word(b + i)) | (word(a + i + 8) ^ word(b + i + 8)) |
+        (word(a + i + 16) ^ word(b + i + 16)) | (word(a + i + 24) ^ word(b + i + 24))) return false;
+  for (; i + 8 <= size; i += 8)
+    if (word(a + i) != word(b + i)) return false;
+  return word(a + size - 8) == word(b + size - 8);
+}
