 #include <unordered_map>
 
 namespace gx {
+#ifdef MELEE_OFFLINE_COST
+// Offline WASM diagnostic: what each capture did, counted only while the decoder cost is collected
+// (melee_decoder_cost(1)), and written per retrace to /work/texture_capture.csv. The miss reasons
+// say why the RAM-version shortcut did not return the cached snapshot: no snapshot for this
+// address yet, no version (outside RAM), a guest store in a watched 64 KB block, a TLUT load
+// anywhere in TMEM (the palette version is a global TMEM generation), or a different palette
+// address or size. `equal` counts the misses whose bytes then compared equal: false invalidations.
+enum TextureMiss { MISS_NEW_SOURCE, MISS_NO_VERSION, MISS_RAM_VERSION, MISS_PALETTE_VERSION, MISS_OTHER, MISS_COUNT };
+struct TextureCaptureCounts {
+  uint64_t calls, version_hits, compares, compare_bytes, hash_bytes, copies, copy_bytes;
+  uint64_t miss[MISS_COUNT], equal[MISS_COUNT], equal_bytes[MISS_COUNT];
+};
+inline bool texture_capture_counting = false;
+inline TextureCaptureCounts texture_capture_counts{};
+#endif
 struct TextureSnapshot {
   std::vector<uint8_t> image, palette;
   uint64_t hash;
@@ -25,6 +40,12 @@ class TextureSnapshotCache {
