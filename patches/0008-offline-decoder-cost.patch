 }
+#ifdef MELEE_OFFLINE_COST
+// Offline WASM diagnostic only. 0 = off, 1 = collect, 2 = legacy discarded clocks.
+inline int offline_cost_mode = 0;
+struct SimCostScope {
+  int slot;
+  uint64_t t0;
+  explicit SimCostScope(int s)
+      : slot(s), t0(offline_cost_mode != 0 ? sim_cost_clock() : 0) {}
+  ~SimCostScope() {
+    if (offline_cost_mode == 0) return;
+    const double seconds = (double)(sim_cost_clock() - t0) * 1e-9;
+    if (offline_cost_mode == 1) sim_cost_add(slot, seconds);
+  }
+};
+#elif defined(MELEE_HEADLESS)
+// Native offline host has no cost collector (sim_cost_add is a stub).
+// Compile out both clock reads; keep the profiling-enabled desktop path below.
+struct SimCostScope { explicit SimCostScope(int) {} };
+#else
 struct SimCostScope { int slot; uint64_t t0; explicit SimCostScope(int s) : slot(s), t0(sim_cost_clock()) {} ~SimCostScope() { sim_cost_add(slot, (double)(sim_cost_clock() - t0) * tsc_seconds); } };
+#endif
 
